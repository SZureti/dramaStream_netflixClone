# Copy to .env.local and fill in from Supabase → Connect (or Project Settings → API Keys).
# Both values are public by design; never put the secret/service_role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Stripe publishable key (client-safe). Use the pk_test_ key from Stripe test mode only.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe secret key and webhook signing secret are server-only: never put them here or in
# .env.local. Set them as Supabase Edge Function secrets instead:
#   supabase secrets set STRIPE_SECRET_KEY=sk_test_... STRIPE_WEBHOOK_SECRET=whsec_... --project-ref qugsfvplmeajymvyjqqn
